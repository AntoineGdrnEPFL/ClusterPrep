{
  "output_dir": "outputs/planck/matched_resolution/A/fold_0",
  "class_names": [
    "RR",
    "RH"
  ],
  "matched_cohort": {
    "source": "../../../phase7b_multimodal",
    "fold": 0
  },
  "experiments": [
    {
      "epochs": 200,
      "batch_size": 16,
      "learning_rate": 5e-05,
      "weight_decay": 0.1,
      "use_class_weights": true,
      "label_smoothing": 0.1,
      "use_scheduler": true,
      "scheduler": "onecycle",
      "max_lr_factor": 3.0,
      "warmup_fraction": 0.3,
      "use_mixup": true,
      "mixup_probability": 0.5,
      "mixup_alpha": 0.4,
      "gradient_clip_norm": 1.0,
      "use_early_stopping": true,
      "patience": 50,
      "drop_last_train": true,
      "name": "planck_A_matched_resolution_fold_0",
      "mode": "multimodal",
      "model": "dual_encoder_cnn",
      "task": "rr_rh",
      "candidate_policy": "positive",
      "seed": 42,
      "size": 128,
      "width": 16,
      "augment": true,
      "cache": true,
      "processed_dir": "processed",
      "verbose": true,
      "num_workers": 0,
      "device": "mps",
      "monitor": "val_loss",
      "min_delta": 0.0,
      "class_weight": "balanced",
      "model_params": {},
      "threshold_selection": "fixed",
      "thresholds": {
        "RR": 0.5,
        "RH": 0.5
      },
      "radio_source": "RAW",
      "modalities": [
        "radio",
        "planck"
      ],
      "missing_modality_policy": "optional",
      "include_masks": true,
      "radio_preprocessing": "matched_resolution",
      "matched_resolution": {
        "radio_mask": "intersection"
      },
      "evaluate_test": true,
      "normalization": {
        "radio": {
          "scope": "train",
          "method": "asinh_percentile",
          "lower_percentile": 30,
          "upper_percentile": 99,
          "alpha": 10.0
        },
        "planck": {
          "scope": "train",
          "method": "standard"
        }
      },
      "planck": {
        "source_path": "planck_PR4_data/PR4_NILC_y_map.fits",
        "cache_dir": "processed/planck_PR4",
        "field": "FULL"
      }
    }
  ]
}
