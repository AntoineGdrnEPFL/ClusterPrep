      "batch_size": 8,
      "epochs": 50,
      "patience": 8
    },
    {
      "name": "image_cnn_multimodal",
      "model": "image_cnn",
      "mode": "multimodal",
      "model_params": {"hidden_dim": 64, "classifier_hidden_dim": 32},
      "size": 128,
      "device": "mps",
      "batch_size": 8,
      "epochs": 50,
      "patience": 8
    }
  ]
}
