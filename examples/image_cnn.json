{
  "data_dir": "scratch/data/PSZ2/classified",
  "output_dir": "results/image_cnn",
  "split": {"split_seed": 42, "test_size": 0.2, "val_size": 0.2},
  "comparison_cohort": "paired",
  "experiments": [
    {
      "name": "image_cnn_radio",
      "model": "image_cnn",
